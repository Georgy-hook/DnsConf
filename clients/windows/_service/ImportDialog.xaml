<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить сервер — NextDNS" Width="610" Height="590" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#0F1825" Foreground="#EEF4FC" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#18283B"/><Setter Property="Foreground" Value="#EEF4FC"/><Setter Property="BorderBrush" Value="#3D536C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#91F2D2"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#18283B"/><Setter Property="Foreground" Value="#EEF4FC"/><Setter Property="Padding" Value="10,8"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#2E4B60"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EEF4FC"/><Setter Property="Background" Value="#18283B"/><Setter Property="BorderBrush" Value="#3D536C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="11,8,28,8" VerticalAlignment="Center"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#91F2D2"/></Grid></Border>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
      <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="#18283B" BorderBrush="#3D536C" BorderThickness="1" MinWidth="190" MaxHeight="250"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="28,23,28,24" Background="#0F1825">
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="27"/><RowDefinition Height="66"/><RowDefinition Height="18"/><RowDefinition Height="26"/><RowDefinition Height="42"/><RowDefinition Height="16"/><RowDefinition Height="26"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Image x:Name="DialogImportIcon" Width="58" Height="58" Margin="0,0,13,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Добавить сервер" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Свой профиль из файла .hosts" Foreground="#9CAEC4" FontSize="13" Margin="0,5,0,0"/></StackPanel></StackPanel>
    <TextBlock Grid.Row="1" Text="Файл настройки" Foreground="#B9CBE0" FontSize="12"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="#152235" BorderBrush="#31465E" BorderThickness="1" CornerRadius="7" Padding="12,9"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectedFileText" Text="Файл не выбран" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock x:Name="FileStatsText" Text="Поддерживаются текстовые .hosts" Foreground="#8FA6C1" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
      <Button Grid.Column="2" x:Name="BrowseFileButton" Content="Выбрать файл…" VerticalAlignment="Center" MinHeight="39"/>
    </Grid>
    <TextBlock Grid.Row="4" Text="Название профиля" Foreground="#B9CBE0" FontSize="12"/>
    <TextBox Grid.Row="5" x:Name="ProfileNameBox" MaxLength="60" AutomationProperties.Name="Название нового профиля"/>
    <TextBlock Grid.Row="7" Text="Страна или регион" Foreground="#B9CBE0" FontSize="12"/>
    <ComboBox Grid.Row="8" x:Name="CountryBox" SelectedIndex="0" AutomationProperties.Name="Страна или регион нового сервера">
      <ComboBoxItem Tag="US" Content="США"/><ComboBoxItem Tag="EU" Content="Европа"/>
      <ComboBoxItem Tag="DE" Content="Германия"/><ComboBoxItem Tag="NL" Content="Нидерланды"/><ComboBoxItem Tag="FI" Content="Финляндия"/>
      <ComboBoxItem Tag="FR" Content="Франция"/><ComboBoxItem Tag="GB" Content="Великобритания"/><ComboBoxItem Tag="SE" Content="Швеция"/>
      <ComboBoxItem Tag="PL" Content="Польша"/><ComboBoxItem Tag="CA" Content="Канада"/><ComboBoxItem Tag="CH" Content="Швейцария"/>
      <ComboBoxItem Tag="TR" Content="Турция"/><ComboBoxItem Tag="JP" Content="Япония"/><ComboBoxItem Tag="SG" Content="Сингапур"/><ComboBoxItem Tag="ZZ" Content="Другая страна"/>
    </ComboBox>
    <StackPanel Grid.Row="9" Margin="0,12,0,0"><TextBlock Text="Импорт добавит профиль в список. Подключить его можно будет отдельно, на карточке сервера." TextWrapping="Wrap" Foreground="#91A6BF" FontSize="12"/><TextBlock x:Name="ImportErrorText" Text="" TextWrapping="Wrap" Foreground="#F4CD8C" FontSize="12" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelImportButton" Content="Отмена" IsCancel="True" MinWidth="100" Margin="0,0,12,0"/><Button x:Name="ConfirmImportButton" Content="Добавить сервер" IsDefault="True" MinWidth="158"/></StackPanel>
  </Grid>
</Window>
