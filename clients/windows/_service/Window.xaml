        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="GlobeIcon" Width="44" Height="44" Margin="-4,0,6,0" />
            <TextBlock x:Name="ProfileCountText" Text="Профили подключения" Foreground="#9DB3CD" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="ImportButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="3,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Image x:Name="ImportIcon" Width="44" Height="44" Margin="0,0,5,0" />
              <TextBlock Text="Добавить сервер" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
