                <Image x:Name="PowerIcon" Width="44" Height="44" Margin="0,0,3,0" />
                <TextBlock Text="Отключить" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Name="ApplyProfileButton" Content="Подключить" Style="{StaticResource ActionButton}" Background="#98EFD5" Foreground="#103129" BorderBrush="#98EFD5" MinWidth="138" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" x:Name="JournalCard" Background="#101C2B" BorderBrush="#2A3F56" BorderThickness="1" CornerRadius="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="49" />
            <RowDefinition Height="39" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
          </Grid.RowDefinitions>
          <Grid Margin="14,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Image x:Name="LogIcon" Width="40" Height="40" Margin="-3,0,5,0" />
              <TextBlock Text="Журнал" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ActionTitle" Grid.Column="1" Text="Готово к работе" Foreground="#8FAAC5" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2" x:Name="CopyLogButton" Content="Копировать" Style="{StaticResource QuietButton}" />
            <Button Grid.Column="3" x:Name="ClearLogButton" Content="Очистить…" Style="{StaticResource QuietButton}" />
          </Grid>
          <Grid Grid.Row="1" Margin="14,0,15,5">
