                  </StackPanel>
                </Button>
              </StackPanel>
              <Grid Grid.Column="1" Margin="6,0,-10,0" IsHitTestVisible="False">
                <Border x:Name="ArtFallback" Background="#183747" CornerRadius="22" />
                <TextBlock x:Name="ArtFallbackGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#528E9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="HeroImage" Stretch="Uniform" AutomationProperties.Name="Стеклянная орбитальная скульптура" />
              </Grid>
            </Grid>
          </Border>
          <Border Background="#142132" BorderBrush="#2A3F56" BorderThickness="1" CornerRadius="20" Padding="17,13" Margin="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image x:Name="ActiveFlag" Width="64" Height="48" Margin="0,0,13,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" Foreground="#859DB9" FontSize="9" />
                  <Border x:Name="StatusPill" Background="#1D443D" CornerRadius="5" Padding="5,2" Margin="9,-2,0,0">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="StatusDot" Width="4" Height="4" Fill="#91F2D2" Margin="0,0,4,0" />
                      <TextBlock x:Name="StatusBadge" Text="HOSTS" FontSize="8" Foreground="#91F2D2" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="StatusTitle" Text="Читаю системный hosts…" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock x:Name="AddressText" Text="—" Foreground="#96B4CE" FontFamily="Consolas" FontSize="12" />
                  <TextBlock x:Name="EntriesText" Text="" Foreground="#7895B2" FontSize="12" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusDescription" Visibility="Collapsed" />
              </StackPanel>
              <Button Grid.Column="2" x:Name="ChangeServerButton" Content="Сменить сервер →" Style="{StaticResource QuietButton}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Grid Margin="2,18,2,4" x:Name="HealthDetailsPanel">
            <Grid.RowDefinitions>
              <RowDefinition Height="48" />
              <RowDefinition Height="48" />
              <RowDefinition Height="48" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ChatGPT" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="AppHealthText" Text="Определяю приложение…" Foreground="#9FB4CF" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" x:Name="OpenAppButton" Content="Открыть ↗" Style="{StaticResource QuietButton}" VerticalAlignment="Center" IsEnabled="False" />
            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#223449" BorderThickness="0,1,0,0" />
            <TextBlock Grid.Row="1" Text="Маршрут" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RouteHealthText" Text="DNS / TLS / HTTP проверяются в фоне" Foreground="#9FB4CF" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RouteTimeText" Text="" Foreground="#7EA2B6" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
            <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#223449" BorderThickness="0,1,0,0" />
            <TextBlock Grid.Row="2" Text="Кеш и журнал" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheHealthText" Text="Собираю сведения…" Foreground="#9FB4CF" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LogsSizeText" Text="" Foreground="#7EA2B6" FontSize="12" VerticalAlignment="Center" />
          </Grid>
          <Grid x:Name="ToolsPanel" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CheckButton" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Padding="8,3,16,3" AutomationProperties.Name="Очистить DNS кеш Windows и повторить проверку">
              <StackPanel Orientation="Horizontal">
                <Image x:Name="CheckIcon" Width="48" Height="48" Margin="0,0,7,0" />
                <TextBlock Text="Очистить DNS-кеш" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="RepairButton" Content="GIF / вложения не работают…" Style="{StaticResource ActionButton}" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Диагностика и восстановление вложений" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
